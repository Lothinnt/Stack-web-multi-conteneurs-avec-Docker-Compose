server
{
    # On ecoute uniquement sur le port 443 en TLS
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name lnjoh-tc.42.fr;

    ssl_certificate /etc/nginx/ssl/inception.crt;
    ssl_certificate_key /etc/nginx/ssl/inception.key;
    ssl_protocols TLSv1.3;

    # Racine du site : le volume WordPress partage avec le conteneur wordpress
    root /var/www/wordpress;
    index index.php index.html;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    #Traitement des requetes PHP -> php-fpm dans le conteneur wordpress
    location ~ \.php$ {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass wordpress:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
    }

    # Bloque les fichiers commençant par .ht
    location ~ /\.ht {
        deny all;
    }
}
