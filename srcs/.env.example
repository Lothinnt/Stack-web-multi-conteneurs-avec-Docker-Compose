# Copier ce fichier en "srcs/.env" et remplir avec vos propres valeurs.
# NE JAMAIS committer le vrai fichier .env (il est ignore par .gitignore).

# Domaine
DOMAIN_NAME=login.42.fr

# Chemin des volumes sur l'hote
#   - en local (macOS/Linux) : /Users/<vous>/data ou /home/<vous>/data
#   - sur la VM d'evaluation 42 : /home/<login>/data
DATA_PATH=/home/login/data

# MariaDB
MARIADB_DATABASE=wordpress
MARIADB_ADMIN_USER=change_me
MARIADB_ADMIN_USER_PASSWORD=change_me
MARIADB_SECOND_USER=change_me
MARIADB_SECOND_USER_PASSWORD=change_me
MARIADB_ROOT_PASSWORD=change_me
DB_HOST=mariadb

# WordPress
WP_URL=https://login.42.fr
WP_TITLE=Inception
# Attention : le login admin NE DOIT PAS contenir "admin" (regle du sujet 42)
WP_ADMIN_USER=change_me
WP_ADMIN_PASSWORD=change_me
WP_ADMIN_EMAIL=change_me@student.42.fr
WP_USER=change_me
WP_USER_PASSWORD=change_me
WP_USER_EMAIL=change_me@student.42.fr
